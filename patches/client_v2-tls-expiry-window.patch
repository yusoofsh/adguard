 const TLS_EXPIRY_WARNING_MS = 30 * 24 * 60 * 60 * 1000;
 
+/**
+ * Warn once less than a third of the certificate's lifetime is left, capped at
+ * 30 days, so short-lived certificates (for example Let's Encrypt's 160-hour
+ * profile) do not keep the banner up between routine renewals.
+ */
+const tlsExpiryWarningMs = (notBefore: number, notAfter: number): number => {
+    const lifetime = notAfter - notBefore;
+    if (!(lifetime > 0)) {
+        return TLS_EXPIRY_WARNING_MS;
+    }
+
+    return Math.min(TLS_EXPIRY_WARNING_MS, lifetime / 3);
+};
